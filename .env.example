# Local (SQLite file next to prisma/schema.prisma)
DATABASE_URL="file:./dev.sqlite"

# Shopify app (Partner Dashboard → App → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_assigned_fulfillment_orders,read_inventory,read_locations,read_merchant_managed_fulfillment_orders,read_orders,read_products,read_publications,read_shipping,write_assigned_fulfillment_orders,write_inventory,write_merchant_managed_fulfillment_orders,write_metaobject_definitions,write_metaobjects,write_orders,write_products,write_publications,write_shipping

# Public URL (no trailing slash)
# Local tunnel: https://xxxx.trycloudflare.com
# Railway: https://your-app.up.railway.app
SHOPIFY_APP_URL=

# Lock vendor login/register to this shop (required if multiple stores use the app)
# Example: mh1i0b-vw.myshopify.com
VENDOR_PORTAL_SHOP=

# Optional: force-publish new seller products to these publication GIDs
# (comma-separated). Use when Headless storefront lookup fails.
# Example: gid://shopify/Publication/123,gid://shopify/Publication/456
PUBLISH_PUBLICATION_IDS=

NODE_ENV=development
