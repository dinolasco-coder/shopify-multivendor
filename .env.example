# Local (SQLite file next to prisma/schema.prisma)
DATABASE_URL="file:./dev.sqlite"

# Shopify app (Partner Dashboard → App → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_inventory,read_locations,read_orders,read_products,read_publications,write_inventory,write_metaobject_definitions,write_metaobjects,write_orders,write_products,write_publications

# Public URL (no trailing slash)
# Local tunnel: https://xxxx.trycloudflare.com
# Railway: https://your-app.up.railway.app
SHOPIFY_APP_URL=

# Lock vendor login/register to this shop (required if multiple stores use the app)
# Example: mh1i0b-vw.myshopify.com
VENDOR_PORTAL_SHOP=

NODE_ENV=development
