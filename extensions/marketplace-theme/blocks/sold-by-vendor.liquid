{% comment %}
  Shows which marketplace vendor sells this product.
  Links to the seller collection when available (handle seller-{{slug}}).
{% endcomment %}
{% assign marketplace_vendor_id = product.metafields.marketplace.vendor_id.value %}
{% if product.vendor != blank or marketplace_vendor_id != blank %}
  <div class="mv-sold-by" {{ block.shopify_attributes }}>
    <p class="mv-sold-by__label">{{ block.settings.label }}</p>
    <p class="mv-sold-by__name">
      {% if product.vendor != blank %}
        {% if block.settings.link_to_seller_collection %}
          {% assign seller_handle = product.vendor | handleize | prepend: 'seller-' %}
          <a href="/collections/{{ seller_handle }}">{{ product.vendor }}</a>
        {% else %}
          {{ product.vendor }}
        {% endif %}
      {% else %}
        Marketplace seller
      {% endif %}
    </p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Sold by vendor",
  "target": "section",
  "stylesheet": "sold-by.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Sold by"
    },
    {
      "type": "checkbox",
      "id": "link_to_seller_collection",
      "label": "Link name to seller collection",
      "default": true
    }
  ]
}
{% endschema %}
