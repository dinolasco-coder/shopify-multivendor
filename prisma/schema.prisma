// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Vendor {
  id                 String             @id @default(cuid())
  shop               String
  name               String
  slug               String             @default(cuid())
  email              String
  passwordHash       String             // random unusable hash for Google-only accounts
  googleId           String?            // Google OAuth subject id
  status             String             @default("pending") // pending | approved | rejected | suspended
  commissionPercent  Float              @default(10)
  commissionFlat     Float              @default(0)
  shopifyCollectionId String?
  shopifyCollectionHandle String?
  bio                String?
  payoutMethod       String?            // gcash | bank | other
  payoutAccountName  String?
  payoutAccountNumber String?
  payoutBankBic      String?            // PayMongo receiving institution BIC
  payoutNotes        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  sessions           VendorSession[]
  attributions       OrderAttribution[]
  payouts            VendorPayout[]
  notifications      VendorNotification[]

  @@unique([shop, email])
  @@unique([shop, googleId])
  @@index([shop, slug])
  @@index([shop, status])
}

model VendorNotification {
  id        String    @id @default(cuid())
  shop      String
  vendorId  String
  type      String    // order_status | payment | customization
  title     String
  body      String?
  href      String?
  refKey    String?   // dedupe key e.g. order:gid / payout:id / custom:attrId
  readAt    DateTime?
  createdAt DateTime  @default(now())
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type, refKey])
  @@index([vendorId, createdAt])
  @@index([vendorId, readAt])
  @@index([shop, vendorId])
}

model VendorSession {
  id        String   @id @default(cuid())
  vendorId  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model OrderAttribution {
  id               String   @id @default(cuid())
  shop             String
  shopifyOrderId   String
  shopifyOrderName String?
  vendorId         String
  lineItemIds      String   // JSON array of line item IDs
  lineItemsJson    String   // JSON details for display
  subtotal         Float
  commissionAmount Float
  currency         String   @default("PHP")
  createdAt        DateTime @default(now())
  vendor           Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([shop, shopifyOrderId, vendorId])
  @@index([shop, vendorId])
  @@index([shop, shopifyOrderId])
}

model VendorPayout {
  id                 String   @id @default(cuid())
  shop               String
  vendorId           String
  amount             Float
  currency           String   @default("PHP")
  note               String?
  reference          String?
  paidAt             DateTime @default(now())
  createdAt          DateTime @default(now())
  status             String   @default("succeeded") // pending | succeeded | failed
  provider           String   @default("manual") // manual | paymongo
  providerTransferId String?
  providerBatchId    String?
  errorMessage       String?
  attributionId      String?
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([shop, vendorId])
  @@index([shop, paidAt])
  @@index([attributionId])
  @@index([providerTransferId])
}

model AppSettings {
  id                       String   @id @default(cuid())
  shop                     String   @unique
  defaultCommissionPercent Float    @default(10)
  defaultCommissionFlat    Float    @default(0)
  requireProductApproval   Boolean  @default(false)
  allowPublicRegistration  Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}
